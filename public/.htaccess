# =====================================================================================================
# hedefecu.com — Alastyr (cPanel · LiteSpeed / Apache 2.4) .htaccess
# OTOMATİK ÜRETİLDİ — elle düzenlemeyin: cd site && npm run htaccess  (scripts/gen-htaccess.mjs)
# Kaynak: ../legacy/url-map.json · Açıklama ve geçiş planı: docs/DEPLOY-ALASTYR.md
# Kanonik köken: https://hedefecu.com   (yönlendirmelerin hepsi buraya, tek atlamada)
# =====================================================================================================

# --- 1) Temel ---------------------------------------------------------------------------------------
# Dizin listeleme KAPALI (eski sitede /wardofit/ ve /wp-content/uploads/ "Index of" veriyordu).
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
# Bilinmeyen adres: gerçek 404 + markalı sayfa. 403/410 da aynı sayfayı gösterir (durum kodu korunur).
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 410 /404.html

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

# --- 2) Yeniden yazma ----------------------------------------------------------------------------------
RewriteEngine On

# 2.0 SSL doğrulaması (cPanel AutoSSL / Let's Encrypt): /.well-known/ hiçbir kurala takılmaz.
RewriteRule ^\.well-known/ - [L]

# 2.1 Gizli/sunucu dosyaları: .htaccess, .git, .env, error_log, php.ini, yedek/arşiv, Cloudflare dosyaları → 403
RewriteRule (?:^|/)\. - [F]
RewriteRule (?:^|/)(?:error_log|php\.ini|_redirects|_headers)$ - [F]
RewriteRule \.(?:sql|zip|tar|tgz|7z|rar|bak|old|orig|log|sh|swp|ini|env)$ - [F]

# 2.1b Eski görsel adresleri (Google Görseller) — sunucuda wp-content/uploads KORUNUR (ops/deploy.sh).
# /wardofit/ = eski WordPress takma adı: pakette kopyası yoksa sunucudaki wp-content/uploads dosyası verilir.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/wp-content/uploads/$1 -f
RewriteRule ^wardofit/(.+\.(?:jpe?g|png|gif|webp|avif|svg|pdf))$ /wp-content/uploads/$1 [L,NC]
# wp-content/uploads altındaki mevcut görsel/PDF doğrudan sunulur; wp-content altındaki diğer her şey 2.2'de 410.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^wp-content/uploads/.+\.(?:jpe?g|png|gif|webp|avif|svg|pdf)$ - [L,NC]
# Sitede hiçbir betik çalışmaz: sunucuda kalmış bir .php/.phtml/.cgi dosyası istenirse 403.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.(?:php\d?|phtml|phar|cgi|pl|py)$ - [F,NC]

<IfModule mod_alias.c>
  RedirectMatch 410 ^/eskisite(?:/.*)?$
</IfModule>

# 2.2 Kalıcı olarak kaldırılanlar (url-map gone-410) → 410 Gone
RewriteCond %{QUERY_STRING} (?:^|&)elementor_library=pricing(?:&|$)
RewriteRule ^(?:index\.php)?$ - [G]
RewriteCond %{QUERY_STRING} (?:^|&)elementor_library=footer-landing(?:&|$)
RewriteRule ^(?:index\.php)?$ - [G]
RewriteCond %{QUERY_STRING} (?:^|&)elementor_library=hidden-sidebar(?:&|$)
RewriteRule ^(?:index\.php)?$ - [G]
