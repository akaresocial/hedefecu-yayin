RewriteRule ^page-sitemap1\.xml$ https://hedefecu.com/sitemap.xml [R=301,L]
RewriteRule ^pxl-template-sitemap1\.xml$ https://hedefecu.com/sitemap.xml [R=301,L]
RewriteRule ^service-sitemap1\.xml$ https://hedefecu.com/sitemap.xml [R=301,L]
RewriteRule ^elementor_library-sitemap1\.xml$ https://hedefecu.com/sitemap.xml [R=301,L]
RewriteRule ^category-sitemap1\.xml$ https://hedefecu.com/sitemap.xml [R=301,L]
RewriteRule ^post_tag-sitemap1\.xml$ https://hedefecu.com/sitemap.xml [R=301,L]
RewriteRule ^service-category-sitemap1\.xml$ https://hedefecu.com/sitemap.xml [R=301,L]

# 2.6 Sonda "/" olmayan klasör adresi → "/"'lu kanonik adres (tek atlama, sorgu korunur). mod_dir DirectorySlash'tan
#     önce çalışır ve http/www durumunda da doğrudan https://kanonik adrese gider.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ https://hedefecu.com/$1/ [R=301,L]

# 2.7 http → https ve www (ya da başka bir alt ad, ör. mail.) → hedefecu.com: tek atlama, yol + sorgu korunur.
#     Hata sayfasının (ErrorDocument /404.html) iç isteği 301'e dönmesin: yalnız ilk istek + 404.html hariç.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} !^/404\.html
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^hedefecu\.com(?::443)?$ [NC]
RewriteRule ^ https://hedefecu.com%{REQUEST_URI} [R=301,L]

# --- 3) Sıkıştırma -------------------------------------------------------------------------------------
# LiteSpeed: br/gzip sunucu düzeyinde (statik dosya sıkıştırma önbelleği); .htaccess'ten açılıp kapanmaz.
# Apache: mod_brotli varsa br, yoksa mod_deflate gzip (dinamik) + aşağıdaki önceden sıkıştırılmış (.br q11 / .gz -9) dosyalar.
<IfModule mod_filter.c>
  <IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css application/xml application/rss+xml application/javascript application/json application/manifest+json image/svg+xml image/x-icon
  </IfModule>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/xml application/rss+xml application/javascript application/json application/manifest+json image/svg+xml image/x-icon
  </IfModule>
</IfModule>

# Önceden sıkıştırılmış dosyalar — yalnız Apache (LiteSpeed kendi sıkıştırır; bu blok orada atlanır)
<IfModule !LiteSpeed>
  <IfModule mod_mime.c>
    # .gz/.br dosyası "arşiv" değil, içerik kodlaması (Content-Encoding) olarak sunulsun
    RemoveType .br .gz
    AddEncoding br .br
    AddEncoding gzip .gz
  </IfModule>
  # Tarayıcı br/gzip kabul ediyorsa ve dosyanın .br/.gz ikizi varsa onu sun (klasör adresleri mod_dir → index.html
  # alt isteğinde yakalanır; hata sayfalarında da çalışır, durum kodu 404/410/403 olarak kalır — yerelde doğrulandı).
  RewriteCond %{HTTP:Accept-Encoding} \bbr\b
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule \.(?:html|xml|txt|svg)$ %{REQUEST_URI}.br [L]
  RewriteCond %{HTTP:Accept-Encoding} \bgzip\b
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule \.(?:html|xml|txt|svg)$ %{REQUEST_URI}.gz [L]
  # Önceden sıkıştırılmış yanıtı sunucu bir daha sıkıştırmasın
  RewriteRule \.(?:br|gz)$ - [E=no-gzip:1,E=no-brotli:1]
  <FilesMatch "\.html\.(?:br|gz)$">
    ForceType "text/html; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.xml\.(?:br|gz)$">
    ForceType "application/xml; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.txt\.(?:br|gz)$">
    ForceType "text/plain; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.svg\.(?:br|gz)$">
    ForceType image/svg+xml
  </FilesMatch>
  <IfModule mod_headers.c>
    <FilesMatch "\.(?:html|xml|txt|svg)(?:\.br|\.gz)?$">
      Header merge Vary Accept-Encoding
    </FilesMatch>
  </IfModule>
</IfModule>

# --- 4) Önbellek (Cache-Control; doğrulama ETag/Last-Modified ile) -------------------------------------
# HTML: her açılışta sunucuya sorulur (304 ile hızlı); yayın sonrası eski sayfa görülmez.
# /_astro/ ve /fonts/: kendi klasörlerindeki .htaccess → 1 yıl immutable (hash'li dosya adları).
<IfModule mod_headers.c>
  <FilesMatch "\.html?(?:\.br|\.gz)?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(?:xml|txt)(?:\.br|\.gz)?$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.(?:jpe?g|png|gif|webp|avif|svg|ico|bmp)(?:\.br|\.gz)?$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(?:woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
# RSS doğru türle (önceden sıkıştırılmış ikizi dahil)
<FilesMatch "^rss\.xml(?:\.br|\.gz)?$">
  ForceType application/rss+xml
</FilesMatch>

# --- 5) Güvenlik başlıkları (GTM/GA4/Ads'i etkilemez; CSP bilerek yok — DEPLOY.md §5.2) -------------------
# HSTS: includeSubDomains YOK (mail/webmail/cpanel alt adları etkilenmesin), preload yok.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>
