RewriteCond %{QUERY_STRING} (?:^|&)elementor_library=default-kit(?:&|$)
RewriteRule ^(?:index\.php)?$ - [G]
RewriteCond %{QUERY_STRING} (?:^|&)s=
RewriteRule ^(?:index\.php)?$ - [G]
RewriteRule ^wp-json(?:/|$) - [G]
RewriteRule ^search(?:/|$) - [G]
RewriteRule ^yonetim(?:/|$) - [G]
RewriteRule ^wp-admin(?:/|$) - [G]
RewriteRule ^wp-content(?:/|$) - [G]
RewriteRule ^eechoawh(?:/|$) - [G]
RewriteRule ^toogocud(?:/|$) - [G]
RewriteRule ^category/uncategorized/?$ - [G]
